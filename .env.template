# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
# Get these from https://console.developers.google.com/apis/credentials
# Create an OAuth 2.0 Client ID
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase Database Configuration
# Get these from your Supabase project settings > Database
# Connect to Supabase via Shared Connection Pooler (for production)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database through Shared Pooler (supports IPv4/IPv6). Used for migrations.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# If your network supports IPv6 or you purchased IPv4 addon, use dedicated pooler (optional)
# DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Discord Webhook for contact form notifications
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# --- Meta Lead Ads webhook -> Discord (app/api/webhooks/meta-leads) ---
# See docs/meta-leads-webhook.md for the full setup walkthrough.

# App Secret from developers.facebook.com > App > App settings > Basic.
# Used to validate the X-Hub-Signature-256 header. Requests without a valid signature are rejected.
META_APP_SECRET=your-meta-app-secret

# Any random string you invent. Paste the SAME value into the Meta App Dashboard
# webhook config. Generate one with: openssl rand -hex 24
META_VERIFY_TOKEN=your-random-verify-token

# Optional but recommended: long-lived Page access token with the leads_retrieval permission.
# Without it the Discord alert still fires instantly, but without the submitted answers.
META_PAGE_ACCESS_TOKEN=your-long-lived-page-access-token

# Optional. Defaults to v25.0.
# META_GRAPH_VERSION=v25.0

# Optional. Dedicated Discord webhook for leads; falls back to DISCORD_WEBHOOK_URL.
DISCORD_LEADS_WEBHOOK_URL=your-discord-leads-webhook-url

# Optional ping on every lead, e.g. @here or <@&ROLE_ID>
# DISCORD_LEADS_MENTION=@here